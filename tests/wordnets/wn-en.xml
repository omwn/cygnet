<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE LexicalResource SYSTEM "https://globalwordnet.github.io/schemas/WN-LMF-1.4.dtd">
<!--
  Test English wordnet.  Concepts here serve as the shared ILI layer;
  other test wordnets (wn-fr.xml etc.) reference ILIs declared here.

  Concepts and relations mirror OEWN structure (simplified):

  Noun hierarchy:
    entity (i1) ← animal (i2) ← dog (i3)
    brightness (i4)  — standalone quality noun
    dogfish (i5)     — standalone noun (enables "dog*" glob test)

  Adjective cluster:
    bright (i6)   — canonical luminosity adjective; has ARASAAC pictogram
    gleaming (i7) — eq_synonym of bright; no direct pictogram (fallback test)
    glowing (i8)  — similar to bright; no direct pictogram (fallback test)

  Sense relations:
    gleaming antonym glowing   — tests sense-level relation display

  Machine-translated gloss:
    mouse (i9) — English gloss is tagged translated_from="fr" with a
    Provenance resource="mtg", mirroring what 5_translate_defns.py
    produces; tests the UI's "(from French)" badge.

  Note: ILI IDs (i1–i8) are test fixtures; i3 is referenced by wn-fr.xml
  and wn-bad.xml, so those three must not be renumbered.
-->
<LexicalResource xmlns:dc="https://globalwordnet.github.io/schemas/dc/">
  <Lexicon id="wn-en" label="Test English WordNet" language="en" email="test@example.org" license="https://creativecommons.org/licenses/by/4.0/" version="1.0" url="https://example.org/" citation="Bond, F. 2025. `Test WordNet &lt;https://github.com/rowanhm/cygnet&gt;`_. In *Proceedings of a Test Conference*.">
    <LexicalEntry id="oewn-entity-n">
      <Lemma writtenForm="entity" partOfSpeech="n"/>
      <Sense id="sense.entity" synset="oewn-entity-n"/>
    </LexicalEntry>
    <LexicalEntry id="oewn-animal-n">
      <Lemma writtenForm="animal" partOfSpeech="n"/>
      <Sense id="sense.animal" synset="oewn-animal-n"/>
    </LexicalEntry>
    <LexicalEntry id="oewn-dog-n">
      <Lemma writtenForm="dog" partOfSpeech="n"/>
      <Form writtenForm="doggo"/>
      <Sense id="sense.dog" synset="oewn-dog-n">
        <Example note="offsets=4,7">The dog barked loudly.</Example>
        <Example note="offsets=105,108">&lt;script&gt;window.__example_xss_fired=true;&lt;/script&gt;&lt;img src=x onerror="window.__example_xss_fired=true;"&gt;A dog is dangerous.</Example>
      </Sense>
    </LexicalEntry>
    <LexicalEntry id="oewn-brightness-n">
      <Lemma writtenForm="brightness" partOfSpeech="n"/>
      <Sense id="sense.brightness" synset="oewn-brightness-n"/>
    </LexicalEntry>
    <LexicalEntry id="oewn-dogfish-n">
      <Lemma writtenForm="dogfish" partOfSpeech="n"/>
      <Sense id="sense.dogfish" synset="oewn-dogfish-n"/>
    </LexicalEntry>
    <LexicalEntry id="oewn-mouse-n">
      <Lemma writtenForm="mouse" partOfSpeech="n"/>
      <Sense id="sense.mouse" synset="oewn-mouse-n"/>
    </LexicalEntry>
    <LexicalEntry id="oewn-bright-a">
      <Lemma writtenForm="bright" partOfSpeech="a"/>
      <Sense id="sense.bright" synset="oewn-bright-a"/>
    </LexicalEntry>
    <LexicalEntry id="oewn-gleaming-a">
      <Lemma writtenForm="gleaming" partOfSpeech="a"/>
      <Sense id="sense.gleaming" synset="oewn-gleaming-a">
        <SenseRelation target="sense.glowing" relType="antonym"/>
      </Sense>
    </LexicalEntry>
    <LexicalEntry id="oewn-glowing-a">
      <Lemma writtenForm="glowing" partOfSpeech="a"/>
      <Sense id="sense.glowing" synset="oewn-glowing-a"/>
    </LexicalEntry>
    <Synset id="oewn-entity-n" ili="i1" partOfSpeech="n">
      <Definition language="en">that which is perceived or known or inferred to have its own distinct existence (living or nonliving)</Definition>
    </Synset>
    <Synset id="oewn-animal-n" ili="i2" partOfSpeech="n">
      <Definition language="en">a living animal; any member of the kingdom Animalia</Definition>
      <SynsetRelation target="oewn-entity-n" relType="hypernym"/>
    </Synset>
    <Synset id="oewn-dog-n" ili="i3" partOfSpeech="n">
      <Definition language="en">a domesticated carnivorous animal (Canis lupus familiaris), the most widely kept companion animal</Definition>
      <SynsetRelation target="oewn-animal-n" relType="hypernym"/>
    </Synset>
    <Synset id="oewn-brightness-n" ili="i4" partOfSpeech="n">
      <Definition language="en">the quality of being bright</Definition>
    </Synset>
    <Synset id="oewn-dogfish-n" ili="i5" partOfSpeech="n">
      <Definition language="en">any of several small sharks with a long pointed snout</Definition>
    </Synset>
    <Synset id="oewn-bright-a" ili="i6" partOfSpeech="a">
      <Definition language="en">emitting or reflecting light readily or in large amounts</Definition>
    </Synset>
    <Synset id="oewn-gleaming-a" ili="i7" partOfSpeech="a">
      <Definition language="en">bright with a steady but subdued sheen</Definition>
      <SynsetRelation target="oewn-bright-a" relType="eq_synonym"/>
    </Synset>
    <Synset id="oewn-glowing-a" ili="i8" partOfSpeech="a">
      <Definition language="en">emitting or reflecting light steadily and softly</Definition>
      <SynsetRelation target="oewn-bright-a" relType="similar"/>
    </Synset>
    <Synset id="oewn-mouse-n" ili="i9" partOfSpeech="n">
      <Definition language="en" note="translated_from=fr">a small rodent with a pointed snout and a long tail</Definition>
    </Synset>
  </Lexicon>
</LexicalResource>
